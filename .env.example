# MEDIA-TARDS — Environment Variables Reference
# Copy this file to .env.local for local development.
# .env.local is gitignored and will NOT be committed.
#
# For Vercel production deployment, set these in the
# Vercel Dashboard → Project Settings → Environment Variables.
# All VITE_ prefixed variables are bundled into client-side JS
# and are intentionally public — do NOT put secrets in them.

# ─────────────────────────────────────────────────────────────
# PRODUCTION SITE URL
# Used for canonical URLs, sitemap, Open Graph metadata.
# Must be the full HTTPS URL with no trailing slash.
# ─────────────────────────────────────────────────────────────
VITE_SITE_URL=https://mediatards.agency

# ─────────────────────────────────────────────────────────────
# CONTACT FORM BACKEND — REQUIRED FOR LAUNCH
# The audit form submits to Formspree.
#
# Steps to configure:
#   1. Create a free account at https://formspree.io
#   2. Create a new form, set the email destination to founders@mediatards.agency
#   3. Copy the form endpoint URL (format: https://formspree.io/f/XXXXXXXX)
#   4. Paste it here
#
# ⚠️  If this variable is not set, the form will NOT fake success.
#    It will surface an error and direct users to email/WhatsApp instead.
# ─────────────────────────────────────────────────────────────
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# ─────────────────────────────────────────────────────────────
# WHATSAPP BUSINESS NUMBER — REQUIRED FOR LAUNCH
# Replace with the real WhatsApp Business number.
# Format: country code + number, digits only, no spaces, no + prefix.
# Example for +91 98765 43210: VITE_WHATSAPP_NUMBER=919876543210
#
# ⚠️  If this variable is not set, WhatsApp buttons will be
#    hidden from the UI (not shown as placeholder/broken links).
# ─────────────────────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX

# ─────────────────────────────────────────────────────────────
# ANALYTICS — OPTIONAL (POST LAUNCH)
# Uncomment and configure if/when analytics are added.
# ─────────────────────────────────────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://app.posthog.com
